# Spike A9/A10: dev tooling on php:8.5-cli-alpine (the CI image candidate).
FROM php:8.5-cli-alpine
COPY --from=composer:2.10.3 /usr/bin/composer /usr/bin/composer
ARG COVERAGE_DRIVER=pcov
RUN apk add --no-cache $PHPIZE_DEPS git unzip \
 && pecl install "$COVERAGE_DRIVER" \
 && docker-php-ext-enable "$COVERAGE_DRIVER" \
 && apk del --no-network $PHPIZE_DEPS
WORKDIR /app
COPY tools/composer.json ./
RUN composer install --no-interaction --no-progress
COPY tools/ ./
COPY scripts/ ./scripts/
RUN composer dump-autoload --no-interaction
