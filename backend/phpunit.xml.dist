<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnNotice="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="conformance">
            <directory>tests/Conformance</directory>
        </testsuite>
        <testsuite name="contract">
            <directory>tests/Contract</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <!-- Fake keys, the same as .env.example and the Compose stack pass to the integration run (so nothing changes there).
         They let the AWS SDK's environment chain find credentials instead of waiting on the instance metadata
         service. Never put real keys here. -->
    <php>
        <!-- The default 128M is nearly used up by the whole suite under coverage (about 75 MB held when
             ForbiddenReferenceScannerTest::testHandlesLargeFilesQuickly tokenises 20,000 lines, which needs about 45 MB
             more), so a few more tests made it fail with an out-of-memory fatal error. -->
        <ini name="memory_limit" value="256M"/>
        <env name="AWS_ACCESS_KEY_ID" value="localdev" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="localdevsecret" force="true"/>
        <env name="AWS_EC2_METADATA_DISABLED" value="true" force="true"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
