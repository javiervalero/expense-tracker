# Local development settings. Copy to .env (`make up` does it for you); .env is git-ignored.
#
# Everything below is NON-SECRET and works only against the local stand-ins in docker-compose.yml.
# Never put real AWS credentials or any real secret in this file or in .env.

# Local-only region label. The emulators ignore it; the SDK needs some value to sign requests.
# It is not the region of any real deployment.
AWS_REGION=eu-west-1

# Fake credentials, accepted by the emulators and by nothing else.
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=localdevsecret

# Stops the AWS SDK from asking the EC2 instance metadata service for credentials.
AWS_EC2_METADATA_DISABLED=true

# Service endpoints as seen from other containers on the Compose network (not from the host).
DYNAMODB_ENDPOINT=http://dynamodb:8000
SQS_ENDPOINT=http://sqs:9324

# Queue URLs (ElasticMQ builds them from the request's host, so these match what the SDK returns).
SQS_RECEIPTS_QUEUE_URL=http://sqs:9324/000000000000/receipts
SQS_RECEIPTS_DLQ_URL=http://sqs:9324/000000000000/receipts-dlq

# S3 emulator (pgsty/silo, ADR 0007). The root user and password of the emulator ARE the AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY above, so one pair of fake credentials works everywhere.
# S3_ENDPOINT: as seen from other containers. S3_PUBLIC_ENDPOINT: as seen from the host and the browser
# (the address presigned URLs are signed for; the signature covers the Host header).
S3_ENDPOINT=http://s3:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Browser origin allowed by the CORS rule on the receipts bucket (the Vite dev server).
S3_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Where the emulator sends "object created" events: its webhook target RELAY, served by the s3-events-relay
# service (WP9). The ARN is derived from the target id: arn:minio:sqs::<ID>:webhook.
# Leave S3_NOTIFICATION_ARN empty to not manage the bucket notification rule at all.
S3_NOTIFICATION_ARN=arn:minio:sqs::RELAY:webhook
S3_WEBHOOK_ENDPOINT=http://s3-events-relay:8080/
# Shared by the emulator (sends it) and the relay (checks it). A fake, LOCAL-ONLY dev value: the relay is not
# reachable from outside the Compose network. On any shared or reachable host, change it to a random secret.
S3_WEBHOOK_AUTH_TOKEN=localdev-webhook-token

# Front-end dev server (Vite, WP14). LOCAL ONLY, NOT A SECRET: both values are read by the Vite dev server only
# (not VITE_-prefixed on purpose, so Vite never copies them into the browser bundle; `make check-bundle-secrets`
# fails the build if the origin-verify value ever shows up in frontend/dist).
# API_PROXY_TARGET: where the dev server forwards /api (the nginx service, as seen from the Compose network).
#   Running Vite on the host instead of in Compose? Use http://127.0.0.1:8080.
# ORIGIN_VERIFY_LOCAL: sent as X-Origin-Verify by the dev proxy, and accepted by the API as ORIGIN_VERIFY_SECRETS
#   (Compose passes it to api-php), which rejects every request without it with 403 (ADR 0012). The healthcheck of
#   `api` and the PHPUnit integration tests send it too. At least 32 visible characters, no spaces or commas.
#   Production uses a real secret held in AWS; never reuse this value there.
API_PROXY_TARGET=http://api:8080
ORIGIN_VERIFY_LOCAL=local-origin-verify-not-a-secret
