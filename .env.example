# Local development settings. Copy to .env (`make up` does it for you); .env is git-ignored.
#
# Everything below is NON-SECRET and works only against the local stand-ins in docker-compose.yml.
# Never put real AWS credentials or any real secret in this file or in .env.

# Local-only region label. The emulators ignore it; the SDK needs some value to sign requests.
# It is not the region of any real deployment.
AWS_REGION=eu-west-1

# Fake credentials, accepted by the emulators and by nothing else.
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=localdevsecret

# Stops the AWS SDK from asking the EC2 instance metadata service for credentials.
AWS_EC2_METADATA_DISABLED=true

# Service endpoints as seen from other containers on the Compose network (not from the host).
DYNAMODB_ENDPOINT=http://dynamodb:8000
SQS_ENDPOINT=http://sqs:9324

# Queue URLs (ElasticMQ builds them from the request's host, so these match what the SDK returns).
SQS_RECEIPTS_QUEUE_URL=http://sqs:9324/000000000000/receipts
SQS_RECEIPTS_DLQ_URL=http://sqs:9324/000000000000/receipts-dlq
