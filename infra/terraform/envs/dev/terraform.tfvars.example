# Copy to terraform.tfvars (git-ignored) and fill in. Placeholders only: never commit real values.
# The layer versions and the Lambda package path come from generated *.auto.tfvars.json files.

aws_region     = "us-east-1"
aws_account_id = "123456789012" # your 12-digit AWS account id

# Which origin-verify secret slot CloudFront sends: "a" or "b".
origin_verify_active_slot = "a"

# Changing a rotation value renews that slot's secret (ADR 0012). Optional; the default is "1".
origin_verify_rotation_a = "1"
origin_verify_rotation_b = "1"

# Where the alarms and budget notifications go. Placeholder: use your own address (SNS emails a link to confirm once).
alert_email = "you@example.com"

# Account-wide monthly budget in US dollars. Optional; the default is 5.
monthly_budget_usd = 5

# Reserved concurrency per function; -1 leaves it unreserved. Optional; Phase 8 reads the account quota first.
api_reserved_concurrent_executions    = -1
worker_reserved_concurrent_executions = -1
