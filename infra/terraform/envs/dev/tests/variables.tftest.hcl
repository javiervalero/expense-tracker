# Offline tests of the input validations. The AWS provider is mocked, so nothing here can reach an account
# (rule 3.1 of the Phase 7 plan; scripts/check-tftest-mocks.sh enforces the mock in every test file).
mock_provider "aws" {}

variables {
  aws_region                = "us-east-1"
  aws_account_id            = "123456789012" # the AWS documentation example account
  environment               = "dev"
  origin_verify_active_slot = "a"
  alert_email               = "alerts@example.com"
  bref_php_layer_versions   = { "us-east-1" = 20 }
  bref_gd_layer_versions    = { "us-east-1" = 1 }
  # Generated by `make lambda-build` (git-ignored package.auto.tfvars.json): the tests give their own values, so they
  # also run on a machine (or in CI) that has not built the package.
  lambda_package_path   = "../../../../build/lambda/backend.zip"
  lambda_package_sha256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" # sha256 of the empty input
}

run "accepts_valid_values" {
  command = plan
}

run "accepts_slot_b" {
  command = plan
  variables {
    origin_verify_active_slot = "b"
  }
}

run "rejects_bad_region" {
  command = plan
  variables {
    aws_region = "Mars"
  }
  expect_failures = [var.aws_region]
}

run "rejects_bad_account_id" {
  command = plan
  variables {
    aws_account_id = "12345"
  }
  expect_failures = [var.aws_account_id]
}

run "rejects_account_id_with_letters" {
  command = plan
  variables {
    aws_account_id = "12345678901a"
  }
  expect_failures = [var.aws_account_id]
}

run "rejects_bad_environment" {
  command = plan
  variables {
    environment = "prod"
  }
  expect_failures = [var.environment]
}

run "rejects_an_empty_package_path" {
  command = plan
  variables {
    lambda_package_path = ""
  }
  expect_failures = [var.lambda_package_path]
}

run "rejects_a_package_path_that_is_not_a_zip" {
  command = plan
  variables {
    lambda_package_path = "../../../../build/lambda/backend.tar"
  }
  expect_failures = [var.lambda_package_path]
}

run "rejects_a_package_sha256_that_is_not_64_lower_case_hex_digits" {
  command = plan
  variables {
    lambda_package_sha256 = "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855"
  }
  expect_failures = [var.lambda_package_sha256]
}

run "rejects_a_package_sha256_of_the_wrong_length" {
  command = plan
  variables {
    lambda_package_sha256 = "e3b0c442"
  }
  expect_failures = [var.lambda_package_sha256]
}

run "rejects_bad_active_slot" {
  command = plan
  variables {
    origin_verify_active_slot = "c"
  }
  expect_failures = [var.origin_verify_active_slot]
}
