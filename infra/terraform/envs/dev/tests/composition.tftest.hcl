# ---------------------------------------------------------------- origin-verify secrets (D16)

run "both_secrets_are_long_visible_ascii_without_a_comma" {
  command = apply

  # The same pattern as ApiConfig::SLOT_PATTERN (backend/src/Infrastructure/Config/ApiConfig.php), minimum length 32.
  assert {
    condition = (
      can(regex("^[\\x21\\x23-\\x5B\\x5D-\\x7E]{32,}$", random_password.origin_verify_a.result))
      && can(regex("^[\\x21\\x23-\\x5B\\x5D-\\x7E]{32,}$", random_password.origin_verify_b.result))
    )
    error_message = "Both secrets must match the PHP slot pattern."
  }

  assert {
    condition     = length(random_password.origin_verify_a.result) == 64 && length(random_password.origin_verify_b.result) == 64
    error_message = "Both secrets must be 64 characters long."
  }

  assert {
    condition     = !strcontains(random_password.origin_verify_a.result, ",") && !strcontains(random_password.origin_verify_b.result, ",")
    error_message = "A secret must never contain the slot separator."
  }

  assert {
    condition = (
      can(regex("^[A-Za-z0-9]+$", random_password.origin_verify_a.result))
      && can(regex("^[A-Za-z0-9]+$", random_password.origin_verify_b.result))
    )
    error_message = "The secrets must be alphanumeric (special = false)."
  }
}

run "the_two_secrets_differ_and_neither_contains_the_other" {
  command = apply

  assert {
    condition     = random_password.origin_verify_a.result != random_password.origin_verify_b.result
    error_message = "The two slots must differ."
  }

  assert {
    condition = (
      !strcontains(random_password.origin_verify_a.result, random_password.origin_verify_b.result)
      && !strcontains(random_password.origin_verify_b.result, random_password.origin_verify_a.result)
    )
    error_message = "Neither slot may contain the other."
  }
}

# These two runs check WIRING only: each slot's keepers come from its own rotation variable, and changing one variable
# changes only that slot's keepers. That a changed keeper really generates a new secret is the random provider's
# documented behaviour, and a test file cannot prove it: a run can read the root's outputs of an earlier run but not
# its resources, and a secret must never be an output (D26, scripts/check-outputs.sh), so the old and the new secret
# cannot be compared. The runs share one state, so the second run applies a change on top of the first.
run "each_slot_is_renewed_by_its_own_rotation_value" {
  command = apply

  variables {
    origin_verify_rotation_a = "2024-rotation-a"
    origin_verify_rotation_b = "2024-rotation-b"
  }

  assert {
    condition     = random_password.origin_verify_a.keepers["rotation"] == "2024-rotation-a"
    error_message = "Slot A must be kept by origin_verify_rotation_a."
  }

  assert {
    condition     = random_password.origin_verify_b.keepers["rotation"] == "2024-rotation-b"
    error_message = "Slot B must be kept by origin_verify_rotation_b."
  }
}

run "changing_the_rotation_value_of_slot_a_changes_only_the_keepers_of_slot_a" {
  command = apply

  variables {
    origin_verify_rotation_a = "2025-rotation-a"
    origin_verify_rotation_b = "2024-rotation-b"
  }

  assert {
    condition     = random_password.origin_verify_a.keepers["rotation"] == "2025-rotation-a"
    error_message = "Slot A's keepers must follow the new origin_verify_rotation_a."
  }

  assert {
    condition     = random_password.origin_verify_b.keepers["rotation"] == "2024-rotation-b"
    error_message = "Slot B's keepers must not change when only origin_verify_rotation_a changes."
  }
}

run "cloudfront_sends_slot_a_when_a_is_active" {
  command = apply

  variables {
    origin_verify_active_slot = "a"
  }

  assert {
    condition     = module.edge.origin_verify_header_value == random_password.origin_verify_a.result
    error_message = "With slot a active the distribution must send secret A."
  }

  assert {
    condition     = module.edge.origin_verify_header_value != random_password.origin_verify_b.result
    error_message = "With slot a active the distribution must not send secret B."
  }
}

run "cloudfront_sends_slot_b_when_b_is_active" {
  command = apply

  variables {
    origin_verify_active_slot = "b"
  }

  assert {
    condition     = module.edge.origin_verify_header_value == random_password.origin_verify_b.result
    error_message = "With slot b active the distribution must send secret B."
  }

  assert {
    condition     = module.edge.origin_verify_header_value != random_password.origin_verify_a.result
    error_message = "With slot b active the distribution must not send secret A."
  }

  # The API accepts both slots whichever one is active (a rotation needs both for a while).
  assert {
    condition     = module.api.environment_variables["ORIGIN_VERIFY_SECRETS"] == "${random_password.origin_verify_a.result},${random_password.origin_verify_b.result}"
    error_message = "ORIGIN_VERIFY_SECRETS must stay <a>,<b> whichever slot is active."
  }
}

run "an_active_slot_other_than_a_or_b_is_refused" {
  command = plan

  variables {
    origin_verify_active_slot = "c"
  }

  expect_failures = [var.origin_verify_active_slot]
}

# ---------------------------------------------------------------- Lambda environments (D23)

run "the_api_accepts_both_slots_in_order" {
  command = apply

  assert {
    condition     = module.api.environment_variables["ORIGIN_VERIFY_SECRETS"] == "${random_password.origin_verify_a.result},${random_password.origin_verify_b.result}"
    error_message = "ORIGIN_VERIFY_SECRETS must be <a>,<b>."
  }
}

run "the_api_environment_has_exactly_the_documented_keys" {
  command = apply

  assert {
    condition = toset(module.api.environment_variable_keys) == toset([
      "APP_ORIGINS",
      "BREF_PING_DISABLE",
      "BREF_RUNTIME",
      "CLIENT_IP_HEADER",
      "DYNAMODB_TABLE",
      "ORIGIN_VERIFY_SECRETS",
      "RECEIPTS_BUCKET",
      "THUMBNAILS_BUCKET",
    ])
    error_message = "The API environment must have exactly the D23 keys."
  }

  assert {
    condition     = module.api.environment_variables["CLIENT_IP_HEADER"] == "CloudFront-Viewer-Address"
    error_message = "CLIENT_IP_HEADER must be CloudFront-Viewer-Address."
  }

  assert {
    condition     = module.api.environment_variables["BREF_RUNTIME"] == "fpm" && module.api.environment_variables["BREF_PING_DISABLE"] == "1"
    error_message = "The API must run the fpm runtime with the ping disabled."
  }
}

run "the_worker_environment_has_exactly_the_documented_keys" {
  command = apply

  assert {
    condition = toset(module.worker.environment_variable_keys) == toset([
      "BREF_PING_DISABLE",
      "BREF_RUNTIME",
      "DYNAMODB_TABLE",
      "RECEIPTS_BUCKET",
      "THUMBNAILS_BUCKET",
    ])
    error_message = "The worker environment must have exactly the D23 keys (no origin-verify keys, no APP_ORIGINS)."
  }

  assert {
    condition     = module.worker.environment_variables["BREF_RUNTIME"] == "function" && module.worker.environment_variables["BREF_PING_DISABLE"] == "1"
    error_message = "The worker must run the function runtime with the ping disabled."
  }
}

run "no_environment_has_an_endpoint_an_app_env_or_a_reserved_aws_key" {
  command = apply

  assert {
    condition = alltrue([
      for key in concat(module.api.environment_variable_keys, module.worker.environment_variable_keys) :
      !endswith(key, "_ENDPOINT") && key != "APP_ENV" && !startswith(key, "AWS_")
    ])
    error_message = "No *_ENDPOINT, no APP_ENV and no AWS_* key may be set (the SDK finds the real endpoints itself)."
  }
}

# ---------------------------------------------------------------- allowed origin (D25)

run "app_origins_and_the_receipts_cors_origin_are_the_distribution_domain_over_https" {
  command = apply

  assert {
    condition     = module.api.environment_variables["APP_ORIGINS"] == "https://${module.edge.domain_name}"
    error_message = "APP_ORIGINS must be https:// plus the distribution domain."
  }

  assert {
    condition     = module.edge.domain_name == "d111111abcdef8.cloudfront.net" && module.api.app_origins == "https://d111111abcdef8.cloudfront.net"
    error_message = "The API's allowed origin must be built from the edge module's domain."
  }

  assert {
    condition     = toset(module.receipts.cors_allowed_origins) == toset([module.api.app_origins])
    error_message = "The receipts bucket must allow exactly the API's origin in CORS."
  }
}

run "the_distribution_reaches_the_api_endpoint" {
  command = apply

  assert {
    condition     = module.edge.api_origin_domain == "a1b2c3d4e5.execute-api.us-east-1.amazonaws.com"
    error_message = "The distribution's API origin must be the API module's endpoint without its scheme."
  }
}

# ---------------------------------------------------------------- timeouts (D8, D12, D13)

run "the_timeout_chain_is_lambda_25_integration_29_cloudfront_30" {
  command = apply

  assert {
    condition     = module.api.lambda_timeout_seconds == 25 && module.api.integration_timeout_milliseconds == 29000 && module.api.cloudfront_origin_read_timeout_seconds == 30
    error_message = "The timeouts must be Lambda 25 s, integration 29000 ms, CloudFront 30 s."
  }

  assert {
    condition = (
      module.api.lambda_timeout_seconds * 1000 < module.api.integration_timeout_milliseconds
      && module.api.integration_timeout_milliseconds < module.api.cloudfront_origin_read_timeout_seconds * 1000
    )
    error_message = "Each timeout in the chain must be shorter than the next one."
  }
}

run "the_queue_visibility_is_at_least_six_worker_timeouts" {
  command = apply

  assert {
    condition     = module.receipts.visibility_timeout_seconds >= 6 * module.worker.timeout_seconds
    error_message = "The receipts queue visibility timeout must be at least 6 times the worker timeout."
  }

  assert {
    condition     = module.worker.timeout_seconds == 30 && module.receipts.visibility_timeout_seconds == 180
    error_message = "The worker timeout is 30 s and the visibility timeout 180 s (D8, D13)."
  }
}

# ---------------------------------------------------------------- shared resources (D4)

run "the_api_and_the_worker_get_the_same_table_and_buckets" {
  command = apply

  assert {
    condition = (
      module.api.environment_variables["DYNAMODB_TABLE"] == module.table.table_name
      && module.worker.environment_variables["DYNAMODB_TABLE"] == module.table.table_name
      && module.table.table_name == "expense-tracker-dev"
    )
    error_message = "Both functions must get the one table."
  }

  assert {
    condition = (
      module.api.environment_variables["RECEIPTS_BUCKET"] == module.receipts.receipts_bucket
      && module.worker.environment_variables["RECEIPTS_BUCKET"] == module.receipts.receipts_bucket
    )
    error_message = "Both functions must get the one receipts bucket."
  }

  assert {
    condition = (
      module.api.environment_variables["THUMBNAILS_BUCKET"] == module.receipts.thumbnails_bucket
      && module.worker.environment_variables["THUMBNAILS_BUCKET"] == module.receipts.thumbnails_bucket
    )
    error_message = "Both functions must get the one thumbnails bucket."
  }
}

run "the_three_buckets_differ_and_share_one_random_suffix" {
  command = apply

  assert {
    condition     = length(distinct([module.receipts.receipts_bucket, module.receipts.thumbnails_bucket, module.edge.site_bucket])) == 3
    error_message = "The receipts, thumbnails and site buckets must have three different names."
  }

  assert {
    condition     = can(regex("^[0-9a-f]{8}$", random_id.bucket_suffix.hex)) && random_id.bucket_suffix.byte_length == 4
    error_message = "The suffix must be one random_id of 4 bytes (8 hex digits)."
  }

  assert {
    condition = (
      module.receipts.receipts_bucket == "expense-tracker-dev-receipts-${random_id.bucket_suffix.hex}"
      && module.receipts.thumbnails_bucket == "expense-tracker-dev-receipt-thumbnails-${random_id.bucket_suffix.hex}"
      && module.edge.site_bucket == "expense-tracker-dev-site-${random_id.bucket_suffix.hex}"
    )
    error_message = "All three buckets must be <name>-<kind>-<the shared suffix>."
  }

  assert {
    condition     = module.receipts.queue_name == "expense-tracker-dev-receipts" && module.receipts.dlq_name == "expense-tracker-dev-receipts-dlq"
    error_message = "The queues must be named after the environment."
  }
}

run "the_table_ceilings_are_400_reads_and_100_writes" {
  command = apply

  assert {
    condition     = module.table.max_read_request_units == 400
    error_message = "The table's read ceiling must be 400 (D15)."
  }

  assert {
    condition     = module.table.max_write_request_units == 100
    error_message = "The table's write ceiling must be 100 (D15)."
  }
}

run "the_csp_hosts_are_built_from_the_bucket_names" {
  command = apply

  assert {
    condition = (
      strcontains(module.edge.content_security_policy, "connect-src 'self' https://${module.receipts.receipts_bucket}.s3.amazonaws.com")
      && strcontains(module.edge.content_security_policy, "img-src 'self' https://${module.receipts.thumbnails_bucket}.s3.amazonaws.com")
    )
    error_message = "The CSP must name the receipts bucket in connect-src and the thumbnails bucket in img-src."
  }

  assert {
    condition = (
      startswith(module.edge.receipts_host, "${module.receipts.receipts_bucket}.")
      && startswith(module.edge.thumbnails_host, "${module.receipts.thumbnails_bucket}.")
    )
    error_message = "The CSP hosts must start with the bucket names."
  }
}

run "the_alarms_watch_the_environments_queues" {
  command = apply

  assert {
    condition     = length(module.observability.alarm_names) == 6
    error_message = "There must be six alarms."
  }

  assert {
    condition     = module.observability.metrics_namespace == "ExpenseTracker/dev"
    error_message = "The metrics must go to ExpenseTracker/dev."
  }

  assert {
    condition     = contains(module.observability.alarm_names, "expense-tracker-dev-receipts-dlq-not-empty")
    error_message = "The DLQ alarm must be named after the dead-letter queue."
  }
}

# ---------------------------------------------------------------- outputs (D26)

run "the_outputs_exist_and_come_from_the_modules" {
  command = apply

  assert {
    condition     = output.distribution_domain == "d111111abcdef8.cloudfront.net"
    error_message = "distribution_domain must be the distribution's domain (no scheme)."
  }

  assert {
    condition     = output.distribution_id == module.edge.distribution_id && output.distribution_id != ""
    error_message = "distribution_id must be the distribution's id (cache invalidation in Phase 8)."
  }

  assert {
    condition     = output.site_bucket == module.edge.site_bucket
    error_message = "site_bucket must be the site bucket."
  }

  assert {
    condition     = output.receipts_bucket == module.receipts.receipts_bucket && output.thumbnails_bucket == module.receipts.thumbnails_bucket
    error_message = "receipts_bucket and thumbnails_bucket must be the receipt buckets."
  }

  assert {
    condition     = output.api_endpoint == "https://a1b2c3d4e5.execute-api.us-east-1.amazonaws.com"
    error_message = "api_endpoint must be the HTTP API's endpoint."
  }

  assert {
    condition     = output.dlq_url == module.receipts.dlq_url
    error_message = "dlq_url must be the dead-letter queue's URL."
  }

  assert {
    condition     = output.table_name == "expense-tracker-dev"
    error_message = "table_name must be the table's name."
  }
}

run "no_output_carries_an_origin_verify_secret" {
  command = apply

  assert {
    condition = alltrue([
      for secret in [random_password.origin_verify_a.result, random_password.origin_verify_b.result] : (
        !strcontains(output.distribution_domain, secret)
        && !strcontains(output.distribution_id, secret)
        && !strcontains(output.site_bucket, secret)
        && !strcontains(output.receipts_bucket, secret)
        && !strcontains(output.thumbnails_bucket, secret)
        && !strcontains(output.api_endpoint, secret)
        && !strcontains(output.dlq_url, secret)
        && !strcontains(output.table_name, secret)
      )
    ])
    error_message = "No output may contain a secret."
  }
}
