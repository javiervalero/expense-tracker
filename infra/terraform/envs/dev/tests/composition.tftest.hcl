# The function's postcondition compares the reported code hash with the one computed from lambda_package_sha256 (the hash
# of the empty input here); the mock returns a random string for it.
override_resource {
  target = module.api.module.function.aws_lambda_function.this
  values = {
    code_sha256 = "47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU="
