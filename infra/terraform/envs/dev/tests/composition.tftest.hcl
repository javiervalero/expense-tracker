# Offline tests of the dev composition itself, envs/dev/{main,locals,secrets,outputs}.tf (D2, D4, D9, D12, D13, D16,
# D17, D18, D23, D25 and D26 of the Phase 7 plan): every module wired together, the shared bucket suffix, the two
# origin-verify secrets, the Lambda environments, the timeout chain and the outputs. The AWS provider is mocked, so
# nothing here can reach an account (scripts/check-tftest-mocks.sh enforces the mock in every test file). The random
# provider is the real one: the secrets and the suffix asserted below are the ones Terraform really generates.
# `command = apply`: under the mock, computed values are only known after apply and ARNs are random strings, so the
# values the provider or a module validates (ARNs, the API endpoint, the distribution domain, the code hash) are pinned
# with override_resource. Every override sits in this file's top level, so it applies to every run's create.
# Not assertable here: `depends_on`, the ABSENCE of a resource, and the absence of an extra output (a test can name
# outputs but cannot list them; the code review and the exact-outputs run below cover that). That the configuration has
# no resource cycle is proven by every run here applying, and by `make tf-check` (validate).
# The secrets are generated at run time and are sensitive: every assertion that touches one is a boolean comparison and
# no error_message quotes it.
mock_provider "aws" {}

variables {
  aws_region                = "us-east-1"
  aws_account_id            = "123456789012" # the AWS documentation example account
  environment               = "dev"
  origin_verify_active_slot = "a"
  alert_email               = "alerts@example.com"
  monthly_budget_usd        = 5
  bref_php_layer_versions   = { "us-east-1" = 20 }
  bref_gd_layer_versions    = { "us-east-1" = 1 }
  # Generated by `make lambda-build` (git-ignored package.auto.tfvars.json): the tests give their own values, so they
  # also run on a machine (or in CI) that has not built the package.
  lambda_package_path   = "../../../../build/lambda/backend.zip"
  lambda_package_sha256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" # sha256 of the empty input
}

