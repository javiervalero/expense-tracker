# Offline tests of the Bref layer version inputs (bref-layers.auto.tfvars.json is generated by scripts/bref-layers.php).
# The AWS provider is mocked (scripts/check-tftest-mocks.sh enforces it in every test file).
mock_provider "aws" {}

variables {
  aws_region                = "us-east-1"
  aws_account_id            = "123456789012" # the AWS documentation example account
  environment               = "dev"
  origin_verify_active_slot = "a"
  bref_php_layer_versions   = { "us-east-1" = 20, "sa-east-1" = 20 }
  bref_gd_layer_versions    = { "us-east-1" = 1, "sa-east-1" = 1 }
  lambda_package_path       = "../../../../build/lambda/backend.zip"
  lambda_package_sha256     = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" # sha256 of the empty input
}

run "accepts_layers_that_cover_the_region" {
  command = plan
}

run "rejects_php_layers_without_the_region" {
  command = plan
  variables {
    bref_php_layer_versions = { "sa-east-1" = 20 }
  }
  expect_failures = [var.bref_php_layer_versions]
}

run "rejects_gd_layers_without_the_region" {
  command = plan
  variables {
    bref_gd_layer_versions = { "sa-east-1" = 1 }
  }
  expect_failures = [var.bref_gd_layer_versions]
}

run "rejects_version_zero" {
  command = plan
  variables {
    bref_php_layer_versions = { "us-east-1" = 0 }
  }
  expect_failures = [var.bref_php_layer_versions]
}

run "rejects_fractional_version" {
  command = plan
  variables {
    bref_gd_layer_versions = { "us-east-1" = 1.5 }
  }
  expect_failures = [var.bref_gd_layer_versions]
}
